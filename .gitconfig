[user]
	email = ryosuke.onose@gmail.com
	name = Ryosuke Onose
[core]
	editor = vim
[merge]
	ff = false
[diff]
	tool = nvimdiff
[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
	prompt = false
[difftool]
	prompt = false
[pull]
	ff = only
[credential "https://git-codecommit.*.amazonaws.com"]
	helper = !aws codecommit credential-helper $@
	UseHttpPath = true
[credential "https://github.com"]
	helper = !gh auth git-credential
